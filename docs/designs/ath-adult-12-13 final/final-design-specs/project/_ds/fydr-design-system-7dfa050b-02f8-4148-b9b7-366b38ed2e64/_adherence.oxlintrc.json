{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/core/**",
              "components/data/**",
              "components/navigation/**",
              "components/patterns/**",
              "ui_kits/athlete_app/**",
              "ui_kits/staff_web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Mono|Sora))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Mono, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|size|role|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initials, size, role, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl|2xl)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:athlete|staff|nutrition)$/]",
        "message": "<Avatar> role must be one of 'athlete' | 'staff' | 'nutrition'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|title|children|action|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, dot, title, children, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|warn|bad|good|plain)$/]",
        "message": "<Banner> tone must be one of 'accent' | 'warn' | 'bad' | 'good' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|shape|danger|disabled|full|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, shape, danger, disabled, full, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|pill)$/]",
        "message": "<Button> shape must be one of 'rect' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pad|state|accent|tint|scroll|minWidth|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, pad, state, accent, tint, scroll, minWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|emphasised|selected|urgent|due|positive)$/]",
        "message": "<Card> state must be one of 'default' | 'emphasised' | 'selected' | 'urgent' | 'due' | 'positive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|variant|count|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, variant, count, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filter|record)$/]",
        "message": "<Chip> variant must be one of 'filter' | 'record'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|display|unit|size|max|tick|tone|stroke|style|key|ref|className|style|children)$/]",
        "message": "<Dial> doesn't accept that prop. Declared props: value, display, unit, size, max, tick, tone, stroke, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|title|style|key|ref|className|style|children)$/]",
        "message": "<DomainDot> doesn't accept that prop. Declared props: state, size, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|due|missed|none)$/]",
        "message": "<DomainDot> state must be one of 'done' | 'due' | 'missed' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|action|tone|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, detail, action, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dashed|confirm)$/]",
        "message": "<EmptyState> tone must be one of 'dashed' | 'confirm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|faint|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'faint' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|domain|domainTone|unit|rule|evidence|raised|value|baseline|severity|acknowledged|onAcknowledge|layout|style|key|ref|className|style|children)$/]",
        "message": "<FlagCard> doesn't accept that prop. Declared props: name, domain, domainTone, unit, rule, evidence, raised, value, baseline, severity, acknowledged, onAcknowledge, layout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagCard'] > JSXAttribute[name.name='domainTone'] > Literal[value!=/^(?:accent|good|warn|bad|highlight)$/]",
        "message": "<FlagCard> domainTone must be one of 'accent' | 'good' | 'warn' | 'bad' | 'highlight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagCard'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<FlagCard> severity must be one of 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlagCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:card|inline)$/]",
        "message": "<FlagCard> layout must be one of 'card' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|display|max|tickAt|tone|height|foot|style|key|ref|className|style|children)$/]",
        "message": "<MeterBar> doesn't accept that prop. Declared props: label, value, display, max, tickAt, tone, height, foot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|badge|actions|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: eyebrow, title, intro, badge, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:good|warn|bad|accent|highlight|outline)$/]",
        "message": "<Pill> tone must be one of 'good' | 'warn' | 'bad' | 'accent' | 'highlight' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Pill> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|low|high|tone|pad|height|label|style|key|ref|className|style|children)$/]",
        "message": "<RangeBar> doesn't accept that prop. Declared props: value, low, high, tone, pad, height, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|headline|body|stats|children|style|key|ref|className|style|children)$/]",
        "message": "<ReadCard> doesn't accept that prop. Declared props: label, headline, body, stats, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScaleSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|words|low|high|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ScaleSelector> doesn't accept that prop. Declared props: value, words, low, high, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
