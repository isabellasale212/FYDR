# Fydr environment. Copy to .env.local and fill in. No secrets are ever committed.

# The Supabase API URL. `supabase start` prints this; locally it is always this value.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon (publishable) key. Safe in the browser: every table is behind RLS and the
# roles that decide access come from the JWT, never from this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. Server side only, never prefixed NEXT_PUBLIC_. Used by
# scripts/seed-auth.ts to create the development logins that seed.sql cannot create,
# because seed.sql writes public.users and auth.users is owned by GoTrue.
SUPABASE_SERVICE_ROLE_KEY=

# The password given to every seeded development login by scripts/seed-auth.ts.
# Development only. There is no production default and there must never be one.
SEED_USER_PASSWORD=fydr-dev-password

# Postgres connection string for `npm run test:tenancy`, which runs the pgTAP suite in
# supabase/tests. `supabase start` prints this; locally it is always this value.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Both unset by default, and every invite email in this project is an honest
# no-op until both are set — see lib/email/provider.ts. Set both to a real Resend API key
# and a verified sender address (https://resend.com/docs/dashboard/domains/introduction)
# to make invite emails actually send; no code change is needed once they're set.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional. Fydr's OWN staff, comma-separated — NOT a club's administrators. The only
# thing it unlocks is the Basic/Premium preview switch on the Plan card, which is a
# sales and support tool: it lets a Fydr person show a club what the other plan looks
# like in the real product. Unset means nobody, which is the right default — the switch
# does not render and the preview cookie is ignored. Compared against the email on the
# verified session; see lib/platformStaff.ts.
FYDR_PLATFORM_EMAILS=
