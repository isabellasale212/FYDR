        "selector": "JSXOpeningElement[name.name='Cell'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|heat|pct|fg|bg|key|ref|className|style|children)$/]",
        "message": "<Cell> doesn't accept that prop. Declared props: text, heat, pct, fg, bg."
