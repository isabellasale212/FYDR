        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|width|height|band|variant|invert|tone|fill|dot|dotTone|padLo|padHi|minColumnWidth|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: points, width, height, band, variant, invert, tone, fill, dot, dotTone, padLo, padHi, minColumnWidth, style."
